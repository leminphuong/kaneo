# General URLs
KANEO_CLIENT_URL=http://localhost:5173
# KANEO_API_URL=http://localhost:1337      # optional - defaults to KANEO_CLIENT_URL/api
# KANEO_INTERNAL_API_URL=http://127.0.0.1:1337 # optional - internal MCP tool requests only
# CORS_ORIGINS=                            # optional - comma-separated; defaults to KANEO_CLIENT_URL

# Database
# DATABASE_URL=                            # optional: use this for host-native or external DB access
POSTGRES_DB=kaneo
POSTGRES_USER=kaneo
POSTGRES_PASSWORD=
# POSTGRES_HOST=postgres                   # Compose container default; use localhost for host-native API startup
# POSTGRES_PORT=5432
# Note: POSTGRES_DB and POSTGRES_USER alone do not enable derived connection mode.
# Derived DATABASE_URL is only used when POSTGRES_PASSWORD or an explicit host/port is set.

# Image and file uploads (Optional) - any S3-compatible store: Cloudflare R2,
# MinIO, AWS S3, Garage. Leave unset to run without uploads; attaching an image
# then fails with "S3 uploads are not configured" and nothing else is affected.
#
# The browser PUTs directly to S3_ENDPOINT with a presigned URL, so the endpoint
# must be reachable from the browser AND the bucket must allow PUT from
# KANEO_CLIENT_URL via CORS. The bucket itself stays private: Kaneo streams
# assets back through its own API.
#
# Cloudflare R2 (use the S3 API endpoint, not the public r2.dev domain):
#S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#S3_BUCKET=kaneo-uploads
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_REGION=auto                 # R2 ignores it; the SDK requires a value
#S3_FORCE_PATH_STYLE=false      # false for R2 and AWS S3, true for MinIO (the default)
#S3_KEY_PREFIX=                 # optional: store objects under a shared prefix
#S3_MAX_IMAGE_UPLOAD_BYTES=     # optional: defaults to 10 MB
#S3_PRESIGN_TTL_SECONDS=        # optional: defaults to 300
# Omit both key variables to fall back to the AWS credential provider chain
# (IAM role / IRSA / environment). R2 always needs an explicit key pair.

# Redis Pub/Sub for WebSockets (Optional) -> auto fallback to in memory
# Only one mode should be configured. Priority: Cluster > Sentinel > Standalone.

# Standalone
#REDIS_URL=

# Sentinel
#REDIS_SENTINELS=
#REDIS_SENTINEL_MASTER_NAME=mymaster
#REDIS_SENTINEL_PASSWORD=
#REDIS_SENTINEL_TLS=false

# Cluster
#REDIS_CLUSTER_NODES=

# Shared (Sentinel & Cluster)
#REDIS_PASSWORD=

# Authentication
# Generate with: openssl rand -hex 32
# If unset, a random secret is generated at startup (sessions won't survive restarts)
AUTH_SECRET=

# Single sign-on from JoyDigi Workspace (or any OAuth2/OIDC provider).
#
# Set these and a "Sign in with..." button appears; no code change is needed.
# With a provider that publishes a discovery document, the discovery URL alone
# replaces the three endpoint variables.
#
#CUSTOM_OAUTH_CLIENT_ID=
#CUSTOM_OAUTH_CLIENT_SECRET=
#CUSTOM_OAUTH_DISCOVERY_URL=https://workspace.joydigi.net/.well-known/openid-configuration
# Only needed when the provider has no discovery document:
#CUSTOM_OAUTH_AUTHORIZATION_URL=
#CUSTOM_OAUTH_TOKEN_URL=
#CUSTOM_OAUTH_USER_INFO_URL=
#CUSTOM_OAUTH_SCOPES=profile,email
#
# The redirect URI to register with the provider is the API's public origin
# plus /api/auth/oauth2/callback/custom. In the bundled image nginx serves the
# app and proxies /api on one origin, so that is:
#   https://your-domain/api/auth/oauth2/callback/custom
# Split deployments must use KANEO_API_URL's origin, not the web app's.
#
# Accounts are matched by email, exactly. An identity only attaches to an
# existing account when that account's email is already verified, which is why
# imported accounts are created verified. A password account somebody signed up
# for themselves is NOT verified, so signing in through SSO with the same
# address creates a second account rather than linking - import those people,
# or have them use SSO from the start. Consider DISABLE_REGISTRATION=true so
# SSO and import are the only ways an account appears.

# Single sign-on from JoyDigi Workspace (the theme's own code hand-off, not
# OAuth). Set the exchange URL and signing in to Workspace signs the user in
# here too; leave it unset and the endpoint does not exist at all.
#
# Workspace frames this app with a one-time code in the URL fragment, the web
# app posts it to /api/auth/workspace-sso/login, and the API redeems it
# server-to-server at the URL below. Nothing the browser claims about who it
# is survives that exchange.
#
#WORKSPACE_SSO_EXCHANGE_URL=https://workspace.joydigi.net/wp-json/joydigi-sso/v1/exchange
#WORKSPACE_SSO_APP_ID=task      # must match the app id configured in Workspace
#WORKSPACE_SSO_SECRET=          # optional; Workspace does not require one
#
# Two rules this never bends:
#   - It never creates an account. Workspace knowing somebody does not make
#     them a member here; import them or add them by hand first.
#   - It only matches an account whose email is already verified. Imported and
#     seeded accounts are created verified; an account somebody signed up for
#     themselves is not, and is refused with ACCOUNT_NOT_VERIFIED so that
#     registering with a colleague's address cannot capture their sign-in.
# Accounts are matched on the exact email address, lower-cased on both sides.
#
# Workspace must also be allowed to frame this app, which apps/web/nginx.*.conf
# already does with Content-Security-Policy: frame-ancestors.

# GitHub SSO (Sign in with GitHub, OAuth App)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Legacy fallback for SSO (used only if GITHUB_OAUTH_* are unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub integration (GitHub App: repository sync, webhooks)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=
# When SMTP is configured, sign-in uses email verification codes by default.
# Set to true to use email/password sign-in instead (invitations still use SMTP).
#DISABLE_EMAIL_OTP_SIGN_IN=false

# Cloud-mode abuse mitigations (only enable on hosted multi-tenant instances).
# When KANEO_CLOUD=true: signup with disposable-email providers is blocked,
# Turnstile is required on /sign-up/email, guest accounts cannot send
# workspace invites, and per-IP rate limits apply to signup + invite paths.
#KANEO_CLOUD=false

# Cloudflare Turnstile (signup captcha). Set the secret key to enforce;
# leave unset to skip verification (self-hosted).
#TURNSTILE_SECRET_KEY=
# Web container: the production image bakes "KANEO_TURNSTILE_SITE_KEY" as a
# placeholder and apps/web/env.sh substitutes it at container start from this
# env var. For local dev (vite), set VITE_TURNSTILE_SITE_KEY in apps/web/.env.
#KANEO_TURNSTILE_SITE_KEY=

# Sentry error tracking (Optional): errors are only reported when a DSN is set
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1         # 0.0 disables; default 0 (opt-in)
# SENTRY_PROFILES_SAMPLE_RATE=0.1      # 0.0 disables; default 0 (opt-in)
# SENTRY_RELEASE=                       # git SHA; ties events to source maps. Falls back to package.json version.
# SENTRY_API_TOKEN=                     # Used by scripts/provision-sentry-alerts.sh and scripts/provision-sentry-dashboards.sh. Scope: org:write. https://sentry.io/settings/account/api/auth-tokens/

# Kaneo Cloud billing via Creem (Optional): only active when KANEO_CLOUD=true
# and both keys are set. Self-hosted installs leave these empty; billing stays off.
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_TEST_MODE=true                     # use Creem's sandbox API
# CREEM_PRODUCT_PERSONAL_MONTHLY=
# CREEM_PRODUCT_PERSONAL_ANNUAL=
# CREEM_PRODUCT_TEAM_MONTHLY=
# CREEM_PRODUCT_TEAM_ANNUAL=
# BILLING_TRIAL_DAYS=14
# BILLING_FOUNDING_CUTOFF=                 # ISO date; workspaces created on/before keep free access
